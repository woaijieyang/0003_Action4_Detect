# Credentials: examples contain no real values
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json

# Local structured configuration; shared configs remain trackable
/configs/local/

# Root-level assets; do not ignore src/data or src/model
/data/*
!/data/README.md
/datasets/
/downloads/
/scene_datasets/
/models/*
!/models/README.md
/weights/
/checkpoints/
/outputs/*
!/outputs/README.md
/runs/
/runtime/*
!/runtime/README.md
/upstream/*
!/upstream/README.md
/logs/

# Model weights anywhere in the tree
*.ckpt
*.safetensors
*.pt
*.pth
*.onnx

# Environments, generated indexes, caches, and build products
.venv/
venv/
.runtime/
.cache/
.codegraph/
.codex/
.agents/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/

# Local logs and editor state
*.log
.vscode/
.idea/
.DS_Store
Thumbs.db

# Project data assets must not leak through alternate locations.
# Keep small, intentional fixtures only with a reviewed, narrow exception.
